<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="/output.css" rel="stylesheet">
    <title>airbnb Home</title>
  </head>
  <body class="bg-gradient-to-br from-gray-50 to-gray-100 min-h-screen flex flex-col items-center justify-center p-4">
    <header class="bg-white rounded-3xl shadow-2xl p-10 mb-8 max-w-2xl w-full text-center border border-gray-200">
      <h1 class="text-3xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-red-700 via-red-600 to-orange-500 mb-6 tracking-tight">
        Registered Homes 
      </h1>
      <ul>
        <% registeredHomes.forEach(home => { %>
          <%= home.houseName %>
        <% }) %>
      </ul>
    </header>
    <main class="text-center">
      <a href="/host/add-home" 
         class="inline-block px-10 py-5 bg-gradient-to-r from-red-700 to-red-800 text-white text-xl font-bold rounded-2xl shadow-xl hover:shadow-3xl hover:from-red-800 hover:to-red-900 transform hover:-translate-y-2 transition-all duration-300 hover:scale-105 active:scale-95">
        Add Home
      </a>
      <p class="mt-6 text-gray-600 font-medium text-lg max-w-md">
        Start hosting your space today
      </p>
    </main>
  </body>
</html>